{% comment %}
  Cart Icon Snippet
  Converted from React CartIcon component
{% endcomment %}

<div class="cart-icon-wrapper relative">
  <a href="{{ routes.cart_url }}" class="cart-icon-link">
    <svg class="w-6 h-6 text-[#493657] hover:text-[#F0C85A] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m6-5v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01"></path>
    </svg>
    
    {% if cart.item_count > 0 %}
      <span class="cart-count absolute -top-2 -right-2 bg-[#F0C85A] text-[#493657] text-xs rounded-full h-5 w-5 flex items-center justify-center font-bold">
        {{ cart.item_count }}
      </span>
    {% endif %}
  </a>
</div>

<style>
  .cart-icon-wrapper {
    position: relative;
  }
  
  .cart-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  
  .cart-count {
    min-width: 20px;
    min-height: 20px;
  }
</style>
