{% comment %}
  Mobile Inspirations Dropdown Snippet
{% endcomment %}

<div class="mobile-inspirations-dropdown w-full flex flex-col items-start">
  <button
    onclick="toggleMobileInspirations()"
    class="mobile-category-button text-[#493657] hover:text-[#F0C85A] flex justify-between w-full"
  >
    <span>Inspirations</span>
    <span class="mobile-arrow transform transition-transform">▶</span>
  </button>
  
  <div class="mobile-submenu transition-all duration-300 ease-in-out overflow-hidden max-h-0 opacity-0 w-full">
    <div class="pl-4 py-2 flex flex-col gap-2">
      {% assign inspiration_categories = "Kitchen,Bedroom,Hallway,Living,Bathroom,Dining,Office,Exterior" | split: "," %}
      
      {% for category in inspiration_categories %}
        <div class="mobile-category-item w-full">
          <a
            href="/pages/inspiration/{{ category | downcase }}"
            class="mobile-subcategory-link text-left text-[#493657] hover:text-[#F0C85A] py-1 w-full block"
          >
            {{ category }} Inspiration
          </a>
        </div>
      {% endfor %}
      
      <div class="pt-2">
        <a href="/pages/inspiration" class="text-[#493657] hover:text-[#F0C85A] font-medium">
          View All Inspirations
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleMobileInspirations() {
    const submenu = document.querySelector('.mobile-inspirations-dropdown .mobile-submenu');
    const arrow = document.querySelector('.mobile-inspirations-dropdown .mobile-arrow');
    const isVisible = submenu.classList.contains('show');
    
    if (isVisible) {
      submenu.classList.remove('show');
      arrow.classList.remove('active');
    } else {
      submenu.classList.add('show');
      arrow.classList.add('active');
    }
  }
</script>
