{% comment %}
  Calyco Testimonials Section (React)
  This section wraps the React Testimonials component
{% endcomment %}

<div
  data-react-root="Testimonials"
  data-props='{
    "title": "{{ section.settings.title | escape }}",
    "subtitle": "{{ section.settings.subtitle | escape }}"
  }'>
</div>

{% schema %}
{
  "name": "Calyco Testimonials (React)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Real experiences from real people"
    }
  ],
  "presets": [
    {
      "name": "Calyco Testimonials (React)"
    }
  ]
}
{% endschema %}
