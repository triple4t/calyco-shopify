{% comment %}
  Calyco CTA Section (React)
  This section wraps the React CTA component
{% endcomment %}

<div
  data-react-root="CTA"
  data-props='{
    "title": "{{ section.settings.title | escape }}",
    "subtitle": "{{ section.settings.subtitle | escape }}",
    "ctaLabel": "{{ section.settings.cta_label | escape }}",
    "ctaUrl": "{{ section.settings.cta_url }}"
  }'>
</div>

{% schema %}
{
  "name": "Calyco CTA (React)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Ready to Transform Your Space?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Start your journey with Calyco today"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Text",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Calyco CTA (React)"
    }
  ]
}
{% endschema %}
