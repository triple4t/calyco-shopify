{% comment %}
  Calyco Hero Section (React)
  This section wraps the React Hero component and passes settings as props
{% endcomment %}

<div
  data-react-root="Hero"
  data-props='{
    "bg": "{{ section.settings.bg | image_url | escape }}",
    "headline": "{{ section.settings.headline | escape }}",
    "subhead": "{{ section.settings.subhead | escape }}",
    "ctaLabel": "{{ section.settings.cta_label | escape }}",
    "ctaUrl": "{{ section.settings.cta_url }}"
  }'>
</div>

{% schema %}
{
  "name": "Calyco Hero (React)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Transform Your Space"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheading",
      "default": "Discover premium eco-friendly paints that bring your vision to life. From interior elegance to exterior protection, we've got you covered."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Calyco Hero (React)"
    }
  ]
}
{% endschema %}
